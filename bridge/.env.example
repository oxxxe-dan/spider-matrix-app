# Required: generate a long random token (at least 32 characters).
# Never commit the real value. Store it in the hosting provider's secret manager.
BRIDGE_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Shared project repository. Use a read-only GitHub token if private repo access is needed.
GITHUB_REPO=oxxxe-dan/spider-matrix-app
GITHUB_REF=bridge/chatgpt-claude-strategytune
GITHUB_TOKEN=

# StrategyTune has no direct external API configured by this scaffold.
# Export StrategyTune results as JSON and place them in this directory.
STRATEGYTUNE_REPORT_DIR=data/strategytune_reports
RESEARCH_INBOX_DIR=data/research_inbox

HOST=0.0.0.0
PORT=8000
